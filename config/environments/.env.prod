# Production Environment Configuration
# Location: /etc/justnews/.env.prod
# Usage: Generated from generate-config.py with --deploy-env production
# Secrets ALWAYS sourced from Vault - NEVER stored in files
# File permissions: 600 (read-only by justnews-app user)

# Application Settings
DEBUG=false
LOG_LEVEL=WARNING
ENVIRONMENT=production
RUN_HOST=0.0.0.0
RUN_PORT=8000

# Database (MariaDB)
# Secrets fetched from Vault ONLY
MARIADB_HOST=mariadb.db.prod.internal
MARIADB_PORT=3306
MARIADB_USER=justnews_prod
MARIADB_PASSWORD=${VAULT_MARIADB_PASSWORD}          # REQUIRED: secret/prod/mariadb/password
MARIADB_DB=justnews_prod
MARIADB_ROOT_PASSWORD=${VAULT_MARIADB_ROOT_PASSWORD} # REQUIRED: secret/prod/mariadb/root_password (backup only)

# Replication (for disaster recovery)
MARIADB_REPLICATION_USER=${VAULT_MARIADB_REPL_USER}     # secret/prod/mariadb/replication_user
MARIADB_REPLICATION_PASSWORD=${VAULT_MARIADB_REPL_PASS} # secret/prod/mariadb/replication_password

# Vector Database (ChromaDB)
CHROMADB_HOST=chromadb.prod.internal
CHROMADB_PORT=3307
CHROMADB_API_VERSION=v1
CHROMADB_AUTH_TOKEN=${VAULT_CHROMADB_AUTH_TOKEN}   # REQUIRED: secret/prod/chromadb/auth_token

# Language Model (vLLM)
VLLM_HOST=vllm.prod.internal
VLLM_PORT=8001
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
VLLM_TENSOR_PARALLEL=4
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_CONCURRENCY=10
VLLM_TIMEOUT=300

# HuggingFace (Model Download)
HF_TOKEN=${VAULT_HF_TOKEN}                          # REQUIRED: secret/prod/huggingface/token

# Django Settings
DJANGO_SETTINGS_MODULE=justnews_publisher.settings
ALLOWED_HOSTS=justnews.example.com,api.justnews.example.com,cdn.justnews.example.com
SECRET_KEY=${VAULT_DJANGO_SECRET_KEY}               # REQUIRED: secret/prod/django/secret_key (never in plaintext)

# Logging (Centralized)
LOG_FILE=/var/log/justnews/app.log
LOG_FORMAT=json
LOG_BACKUP_COUNT=30                                 # Keep 30 days
LOG_MAX_BYTES=52428800                             # 50MB per file
LOG_SHIPPED_TO=syslog:/var/run/log/socket          # Shipped to central logging
AUDIT_LOG_FILE=/var/log/justnews/audit.log          # Separate audit trail
AUDIT_LOG_RETENTION=90                              # 90 days minimum

# Development Tools (Completely Disabled in Production)
IPYTHON_ENABLED=false
TOOLBAR_ENABLED=false
PROFILER_ENABLED=false
DEBUG_TOOLBAR_ENABLED=false

# Cache Settings (production - distributed cache)
CACHE_BACKEND=redis_cluster
CACHE_LOCATION=redis://redis-cluster.prod.internal:6379/1
CACHE_TIMEOUT=86400                                 # 24 hours
CACHE_MAX_ENTRIES=100000

# Email (Production SMTP with TLS)
EMAIL_BACKEND=smtp
EMAIL_HOST=mail.prod.internal
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=${VAULT_EMAIL_USER}                # REQUIRED: secret/prod/email/user
EMAIL_HOST_PASSWORD=${VAULT_EMAIL_PASSWORD}        # REQUIRED: secret/prod/email/password
EMAIL_FROM=noreply@justnews.example.com
EMAIL_REPLY_TO=support@justnews.example.com

# Security (Fully Hardened for Production)
CSRF_TRUSTED_ORIGINS=https://justnews.example.com,https://api.justnews.example.com
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict
SECURE_HSTS_SECONDS=31536000                       # 1 year
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_BROWSER_XSS_FILTER=true
SECURE_CONTENT_SECURITY_POLICY=true
CSP_HEADER=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'
CORS_ALLOWED_ORIGINS=https://justnews.example.com

# API Authentication (Required for all external calls)
API_KEY_VALIDATION=true
API_RATE_LIMIT_ENFORCED=true
API_RATE_LIMIT_REQUESTS=1000
API_RATE_LIMIT_PERIOD=3600                         # 1000 req/hour

# JWT Configuration (if applicable)
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30
JWT_SECRET=${VAULT_JWT_SECRET}                    # REQUIRED: secret/prod/jwt/secret

# Encryption (All data encrypted at rest)
ENCRYPTION_KEY=${VAULT_ENCRYPTION_KEY}             # REQUIRED: secret/prod/encryption/key
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_CERT=${VAULT_ENCRYPTION_CERT}           # Optional TLS cert path

# Monitoring & Observability (Production-Grade)
SENTRY_DSN=${VAULT_SENTRY_DSN}                    # REQUIRED: secret/prod/sentry/dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACE_SAMPLE_RATE=0.10                     # 10% sampling for performance
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s
DATADOG_API_KEY=${VAULT_DATADOG_API_KEY}          # REQUIRED: secret/prod/datadog/api_key
DATADOG_APP_KEY=${VAULT_DATADOG_APP_KEY}          # REQUIRED: secret/prod/datadog/app_key
DATADOG_SERVICE_NAME=justnews-prod
DATADOG_ENVIRONMENT=production
DATADOG_TRACE_ENABLED=true

# Alerting (PagerDuty)
PAGERDUTY_INTEGRATION_KEY=${VAULT_PAGERDUTY_KEY}  # secret/prod/pagerduty/integration_key
ALERT_EMAIL=ops-team@justnews.example.com
ALERT_SLACK_WEBHOOK=${VAULT_SLACK_WEBHOOK}        # secret/prod/slack/webhook_url

# TLS/HTTPS Configuration
TLS_ENABLED=true
TLS_CERT_PATH=/etc/justnews/certs/server.crt
TLS_KEY_PATH=/etc/justnews/certs/server.key
TLS_CA_PATH=/etc/justnews/certs/ca.crt
TLS_VERIFY_PEER=true
TLS_CHECK_INTERVAL=86400                          # Check expiry daily

# Rate Limiting (Anti-Abuse)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60                               # 100 req/minute aggressive
RATE_LIMIT_WHITELIST=${VAULT_RATE_LIMIT_WHITELIST} # secret/prod/ratelimit/whitelist

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *                         # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=s3://justnews-backups-prod/
BACKUP_ENCRYPTION_KEY=${VAULT_BACKUP_KEY}        # REQUIRED: secret/prod/backup/encryption_key

# Disaster Recovery
FAILOVER_ENABLED=true
FAILOVER_CHECK_INTERVAL=30                        # 30 seconds
FAILOVER_DB_REPLICA=mariadb-replica.prod.internal
FAILOVER_REPLICA_PORT=3306

# Vault Configuration (Critical for Production)
VAULT_ADDR=https://vault.prod.internal:8200
VAULT_NAMESPACE=prod
VAULT_AUTH_METHOD=kubernetes                      # Using k8s auth in production
VAULT_SERVICE_ACCOUNT=justnews-prod
VAULT_ROLE=justnews-prod
VAULT_JWT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
VAULT_RETRY_ATTEMPTS=3
VAULT_RETRY_WAIT=2

# Feature Flags
FEATURE_BETA_ANALYTICS=false
FEATURE_BETA_RECOMMENDATIONS=false
FEATURE_EXPERIMENTAL_CONFIG=false

# Performance Tuning
WORKER_THREADS=8
WORKER_TIMEOUT=120
DB_CONNECTION_POOL_SIZE=20
DB_CONNECTION_POOL_RECYCLE=3600
CACHE_WARM_ON_STARTUP=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_SUCCESS_THRESHOLD=1
HEALTH_CHECK_FAILURE_THRESHOLD=3

# API Versioning
API_VERSION=v2
API_DEPRECATION_HEADERS=true

# Notes for Production Deployment
# ====================================
# CRITICAL SECURITY REQUIREMENTS:
#
# 1. File Permissions:
#    - sudo chown justnews-app:justnews-app /etc/justnews/.env.prod
#    - sudo chmod 600 /etc/justnews/.env.prod
#
# 2. Vault Integration:
#    - Install HashiCorp Vault client on deployment host
#    - Configure Vault authentication (Kubernetes or AppRole recommended)
#    - Run: infrastructure/scripts/fetch_secrets_to_env.sh
#    - Never commit actual secrets to version control
#
# 3. Secret Rotation:
#    - Implement automatic secret rotation (every 90 days recommended)
#    - Update rotation schedule in Vault policies
#    - Test rotation procedure in staging first
#
# 4. Secrets NEVER to include in file:
#    - Database passwords
#    - API keys
#    - Encryption keys
#    - JWT secrets
#    - Third-party service tokens
#
# 5. Access Control:
#    - Restrict read access to justnews-app user only
#    - Use sudo for manual edits by ops team
#    - Audit all file access with: auditctl
#
# 6. Monitoring:
#    - Monitor /etc/justnews/ directory for unauthorized changes
#    - Alert if file permissions change
#    - Monitor Vault audit logs for secret access
#
# 7. Disaster Recovery:
#    - Keep encrypted backup of this template (no secrets)
#    - Store Vault recovery keys in secure offsite location
#    - Test restore procedure quarterly
#
# 8. Pre-Deployment Validation:
#    - Verify all VAULT_* variables can be resolved
#    - Test TLS certificates (expiry, chain validity)
#    - Validate DNS resolution for all hosts
#    - Perform security scan (OWASP Top 10)
#
# 9. Post-Deployment Validation:
#    - Run full integration test suite
#    - Verify all services operational (MariaDB, ChromaDB, vLLM)
#    - Check logs for errors or warnings
#    - Verify monitoring and alerts working
#
# Generated by: infrastructure/scripts/generate-config.py
# Generated at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
# Generator version: 1.0
