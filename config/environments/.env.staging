# Staging Environment Configuration
# Location: config/environments/.env.staging
# Usage: Generated from generate-config.py with --deploy-env staging
# Secrets sourced from Vault at startup

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=staging
RUN_HOST=0.0.0.0
RUN_PORT=8000

# Database (MariaDB)
# Secrets fetched from Vault
MARIADB_HOST=mariadb.staging.internal
MARIADB_PORT=3306
MARIADB_USER=justnews_staging
MARIADB_PASSWORD=${VAULT_MARIADB_PASSWORD}          # Injected from: secret/staging/mariadb/password
MARIADB_DB=justnews_staging
MARIADB_ROOT_PASSWORD=${VAULT_MARIADB_ROOT_PASSWORD} # Injected from: secret/staging/mariadb/root_password

# Vector Database (ChromaDB)
CHROMADB_HOST=chromadb.staging.internal
CHROMADB_PORT=3307
CHROMADB_API_VERSION=v1

# Language Model (vLLM)
VLLM_HOST=vllm.staging.internal
VLLM_PORT=8001
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
VLLM_TENSOR_PARALLEL=2
VLLM_GPU_MEMORY_UTILIZATION=0.85

# HuggingFace (Model Download)
HF_TOKEN=${VAULT_HF_TOKEN}                          # Injected from: secret/staging/huggingface/token

# Django Settings
DJANGO_SETTINGS_MODULE=justnews_publisher.settings
ALLOWED_HOSTS=staging.justnews.local,staging-api.justnews.local

# Logging
LOG_FILE=/var/log/justnews/app.log
LOG_FORMAT=json
LOG_BACKUP_COUNT=10
LOG_MAX_BYTES=52428800                             # 50MB

# Development Tools (Disabled in Staging)
IPYTHON_ENABLED=false
TOOLBAR_ENABLED=false
PROFILER_ENABLED=false

# Cache Settings (staging - light caching)
CACHE_BACKEND=redis
CACHE_LOCATION=redis://redis.staging.internal:6379/1
CACHE_TIMEOUT=3600                                  # 1 hour

# Email (Staging SMTP)
EMAIL_BACKEND=smtp
EMAIL_HOST=mail.staging.internal
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=${VAULT_EMAIL_USER}                # Injected from: secret/staging/email/user
EMAIL_HOST_PASSWORD=${VAULT_EMAIL_PASSWORD}        # Injected from: secret/staging/email/password

# Security (Staging - Partially Hardened)
CSRF_TRUSTED_ORIGINS=staging.justnews.local,staging-api.justnews.local
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=3600                           # 1 hour
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
CORS_ALLOWED_ORIGINS=https://staging.justnews.local,https://staging-api.justnews.local

# Encryption (Staging - Vault-Managed)
ENCRYPTION_KEY=${VAULT_ENCRYPTION_KEY}             # Injected from: secret/staging/encryption/key

# Monitoring & Observability
SENTRY_DSN=${VAULT_SENTRY_DSN}                    # Injected from: secret/staging/sentry/dsn
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
DATADOG_API_KEY=${VAULT_DATADOG_API_KEY}          # Injected from: secret/staging/datadog/api_key (optional)

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600                             # 100 requests per hour

# Vault Configuration (for fetch_secrets_to_env.sh)
VAULT_ADDR=https://vault.staging.internal:8200
VAULT_NAMESPACE=staging
VAULT_AUTH_METHOD=approle
VAULT_ROLE_ID=${STAGING_VAULT_ROLE_ID}            # Set in CI/CD pipeline
VAULT_SECRET_ID=${STAGING_VAULT_SECRET_ID}        # Set in CI/CD pipeline

# Notes for Staging Team
# - All passwords are stored in Vault (secret/staging/*)
# - Use fetch_secrets_to_env.sh before starting services
# - TLS is enforced; self-signed certs acceptable for internal staging
# - Run security audit before promoting to production
# - Monitor logs at /var/log/justnews/app.log
# - Email notifications enabled for workflow alerts
