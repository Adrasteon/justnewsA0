# Development Environment Configuration
# Location: config/environments/.env.dev
# Usage: source config/environments/.env.dev (during development)

# Application Settings
DEBUG=true
LOG_LEVEL=DEBUG
ENVIRONMENT=development
RUN_HOST=127.0.0.1
RUN_PORT=8000

# Database (MariaDB)
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_USER=justnews
MARIADB_PASSWORD=dev_justnews_password
MARIADB_DB=justnews
MARIADB_ROOT_PASSWORD=dev_root_password

# Vector Database (ChromaDB)
CHROMADB_HOST=chromadb
CHROMADB_PORT=3307
CHROMADB_API_VERSION=v1

# Language Model (vLLM)
VLLM_HOST=vllm
VLLM_PORT=8001
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
VLLM_TENSOR_PARALLEL=1
VLLM_GPU_MEMORY_UTILIZATION=0.9

# HuggingFace (Model Download)
HF_TOKEN=dev_token_not_needed_for_local_model

# Django Settings
DJANGO_SETTINGS_MODULE=justnews_publisher.settings
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Logging
LOG_FILE=/tmp/justnews_dev.log
LOG_FORMAT=json

# Development Tools
IPYTHON_ENABLED=true
TOOLBAR_ENABLED=true
PROFILER_ENABLED=true

# Cache Settings (development - no caching)
CACHE_BACKEND=dummy
SESSION_BACKEND=memory

# Email (Console Output)
EMAIL_BACKEND=console

# Security (Development - Relaxed)
CSRF_TRUSTED_ORIGINS=localhost:8000,127.0.0.1:8000
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
CORS_ALLOWED_ORIGINS=*

# Encryption (Development - Plaintext OK)
ENCRYPTION_KEY=dev_key_not_secure

# Notes for Developers
# - All passwords are for development only
# - Services run via docker-compose in .devcontainer/
# - Change LOG_LEVEL to DEBUG for detailed logging
# - Set PROFILER_ENABLED=true to see performance issues
