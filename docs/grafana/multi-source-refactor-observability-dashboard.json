{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "#000000",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Verified Share (5m)",
      "id": 101,
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "max(justnews_custom_gauge_published_verified_share{agent=\"workflow_orchestrator\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": ""}, "orientation": "horizontal"}
    },
    {
      "type": "timeseries",
      "title": "Published Lane Totals (5m rate)",
      "id": 102,
      "datasource": "Prometheus",
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(justnews_custom_counter_published_total_verified_story_total{agent=\"workflow_orchestrator\"}[5m]))",
          "legendFormat": "verified_story",
          "refId": "A"
        },
        {
          "expr": "sum(rate(justnews_custom_counter_published_total_developing_brief_total{agent=\"workflow_orchestrator\"}[5m]))",
          "legendFormat": "developing_brief",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "Promotion Failures by Reason (5m rate)",
      "id": 103,
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (__name__) (rate({__name__=~\"justnews_custom_counter_cluster_promotion_failures_.*_total\",agent=\"workflow_orchestrator\"}[5m]))",
          "legendFormat": "{{__name__}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right"}}
    },
    {
      "type": "stat",
      "title": "Median Unique Domains per Story",
      "id": 104,
      "datasource": "Prometheus",
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "max(justnews_custom_gauge_median_unique_domains_per_story{agent=\"workflow_orchestrator\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": ""}, "orientation": "horizontal"}
    },
    {
      "type": "timeseries",
      "title": "Singleton to Verified Conversion (15m rate)",
      "id": 105,
      "datasource": "Prometheus",
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(justnews_custom_counter_singleton_to_verified_conversion_total_total{agent=\"workflow_orchestrator\"}[15m]))",
          "legendFormat": "conversion_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    }
  ],
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["multi-source", "workflow-orchestrator", "integrity-refactor"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h"]},
