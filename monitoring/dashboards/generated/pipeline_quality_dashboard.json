{
  "id": null,
  "uid": "pipeline-quality-premium",
  "title": "Pipeline Quality & Publishing",
  "description": "Editorial acceptance rates, publishing latency, and content quality metrics",
  "tags": ["pipeline", "quality", "editorial", "enterprise"],
  "timezone": "UTC",
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Editorial Pipeline Health",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Editorial Acceptance (median)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 1},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(justnews_stage_b_editorial_acceptance_bucket[6h])) by (le)) * 100", "legendFormat": "acceptance %"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {"mode": "percentage", "steps": [
            {"color": "red", "value": 0},
            {"color": "yellow", "value": 40},
            {"color": "green", "value": 70}
          ]}
        }
      }
    },
    {
      "id": 3,
      "title": "Publishing Latency p50",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 1},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(justnews_stage_b_publishing_latency_seconds_bucket[6h])) by (le))", "legendFormat": "p50"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 2},
            {"color": "red", "value": 5}
          ]}
        }
      }
    },
    {
      "id": 4,
      "title": "Publishing Latency p95",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 1},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(justnews_stage_b_publishing_latency_seconds_bucket[6h])) by (le))", "legendFormat": "p95"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 5},
            {"color": "red", "value": 10}
          ]}
        }
      }
    },
    {
      "id": 5,
      "title": "Editorial Acceptance Metrics",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false
    },
    {
      "id": 6,
      "title": "Acceptance Rate by 5m Window",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(justnews_stage_b_editorial_acceptance_bucket[5m])) by (le)) * 100", "legendFormat": "median acceptance"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "custom": {"lineWidth": 2}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 7,
      "title": "Editorial Acceptance Distribution (p10-p90)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "histogram_quantile(0.10, sum(rate(justnews_stage_b_editorial_acceptance_bucket[5m])) by (le)) * 100", "legendFormat": "p10"},
        {"expr": "histogram_quantile(0.50, sum(rate(justnews_stage_b_editorial_acceptance_bucket[5m])) by (le)) * 100", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.90, sum(rate(justnews_stage_b_editorial_acceptance_bucket[5m])) by (le)) * 100", "legendFormat": "p90"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 8,
      "title": "Publishing Performance",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "collapsed": false
    },
    {
      "id": 9,
      "title": "Publishing Latency - p50/p95/p99 (5m windows)",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 15},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(justnews_stage_b_publishing_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(justnews_stage_b_publishing_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(justnews_stage_b_publishing_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"fillOpacity": 10, "lineWidth": 2}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 10,
      "title": "24h Quality Stats",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 25},
      "targets": [
        {"expr": "label_values(justnews_stage_b_editorial_acceptance_bucket, le)", "format": "table"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      }
    }
  ],
  "version": 3,
  "schemaVersion": 36,
  "style": "dark"
}
