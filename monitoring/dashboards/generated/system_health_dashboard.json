{
  "id": null,
  "uid": "system-health-premium",
  "title": "System Health & Infrastructure",
  "description": "Comprehensive system infrastructure monitoring with resource utilization, capacity planning, and health indicators",
  "tags": ["system", "infrastructure", "enterprise"],
  "timezone": "UTC",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(up{job=~\".*\"}, instance)",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "label": "Instance"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "System Status",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Fleet Availability",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "targets": [
        {"expr": "sum(up{job=~\".*\"})", "legendFormat": "Up"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": 0},
            {"color": "yellow", "value": 1},
            {"color": "green", "value": 2}
          ]}
        }
      }
    },
    {
      "id": 3,
      "title": "Avg CPU Usage",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "targets": [
        {"expr": "avg(100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100))", "legendFormat": "CPU %"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {"mode": "percentage", "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 70},
            {"color": "red", "value": 90}
          ]}
        }
      }
    },
    {
      "id": 4,
      "title": "Avg Memory Usage",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "targets": [
        {"expr": "avg((1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100)", "legendFormat": "Memory %"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {"mode": "percentage", "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 75},
            {"color": "red", "value": 90}
          ]}
        }
      }
    },
    {
      "id": 5,
      "title": "Avg Disk Usage",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "targets": [
        {"expr": "avg((1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|devtmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|devtmpfs\"}) * 100)", "legendFormat": "Disk %"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {"mode": "percentage", "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 80},
            {"color": "red", "value": 95}
          ]}
        }
      }
    },
    {
      "id": 6,
      "title": "Resource Utilization",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false
    },
    {
      "id": 7,
      "title": "CPU Utilization by Host",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "max": 100},
        "overrides": [
          {
            "matcher": {"id": "byName"},
            "properties": [
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "custom.lineWidth", "value": 2}
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 8,
      "title": "Memory Utilization by Host",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "{{instance}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "max": 100},
        "overrides": [
          {
            "matcher": {"id": "byName"},
            "properties": [
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "custom.lineWidth", "value": 2}
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 9,
      "title": "System Load (1m, 5m, 15m)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {"expr": "node_load1", "legendFormat": "load1 {{instance}}"},
        {"expr": "node_load5", "legendFormat": "load5 {{instance}}"},
        {"expr": "node_load15", "legendFormat": "load15 {{instance}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 10,
      "title": "Network I/O Throughput",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [
        {"expr": "sum(rate(node_network_receive_bytes_total[5m]) + rate(node_network_transmit_bytes_total[5m])) by (instance)", "legendFormat": "{{instance}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "Bps"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 11,
      "title": "Disk I/O Operations",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "targets": [
        {"expr": "sum(rate(node_disk_reads_completed_total[5m])) by (instance)", "legendFormat": "reads {{instance}}"},
        {"expr": "sum(rate(node_disk_writes_completed_total[5m])) by (instance)", "legendFormat": "writes {{instance}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 12,
      "title": "Disk Pressure - Top 10 Hotspots",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "targets": [
        {"expr": "topk(10, (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|devtmpfs\", mountpoint=\"/\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|devtmpfs\", mountpoint=\"/\"}) * 100)", "legendFormat": "{{instance}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {"mode": "percentage", "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 80},
            {"color": "red", "value": 95}
          ]}
        }
      },
      "options": {"orientation": "horizontal"}
    }
  ],
  "version": 3,
  "schemaVersion": 36,
  "style": "dark"
}
