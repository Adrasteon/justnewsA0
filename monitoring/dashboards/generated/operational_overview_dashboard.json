{
  "id": null,
  "uid": "operational-overview-premium",
  "title": "Operational Overview",
  "description": "Single pane of glass for JustNews operations - consolidated key metrics from all dashboards",
  "tags": ["overview", "operations", "enterprise", "consolidated"],
  "timezone": "UTC",
  "refresh": "10s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "System Health & Status",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Fleet Health",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "targets": [
        {"expr": "max(justnews_agent_health_status{target=\"overall\"})", "legendFormat": "health"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {"type": "value", "options": {
              "0": {"text": "Healthy", "color": "green"},
              "1": {"text": "Degraded", "color": "orange"},
              "2": {"text": "Unhealthy", "color": "red"},
              "3": {"text": "Unreachable", "color": "red"}
            }}
          ],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "orange", "value": 1},
            {"color": "red", "value": 2}
          ]}
        }
      }
    },
    {
      "id": 3,
      "title": "CPU Utilization",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "targets": [
        {"expr": "avg(1 - (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "cpu_util"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "orange", "value": 0.75},
            {"color": "red", "value": 0.9}
          ]}
        }
      }
    },
    {
      "id": 4,
      "title": "Memory Utilization",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "targets": [
        {"expr": "avg((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)))", "legendFormat": "mem_util"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "orange", "value": 0.75},
            {"color": "red", "value": 0.9}
          ]}
        }
      }
    },
    {
      "id": 5,
      "title": "Disk Utilization",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "targets": [
        {"expr": "avg((node_filesystem_avail_bytes / node_filesystem_size_bytes))", "legendFormat": "disk_free"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0.1},
            {"color": "orange", "value": 0.05},
            {"color": "red", "value": 0.02}
          ]}
        }
      }
    },
    {
      "id": 6,
      "title": "Network Health",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "targets": [
        {"expr": "sum(rate(node_network_transmit_bytes_total[5m]))", "legendFormat": "tx"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0}
          ]}
        }
      }
    },
    {
      "id": 7,
      "title": "Active Agents",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "targets": [
        {"expr": "sum(justnews_agent_health_status{target=\"per_agent\"} == 0)", "legendFormat": "healthy"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 1}
          ]}
        }
      }
    },
    {
      "id": 8,
      "title": "Request Metrics",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false
    },
    {
      "id": 9,
      "title": "Throughput (requests/sec)",
      "type": "stat",
      "gridPos": {"h": 3, "w": 6, "x": 0, "y": 6},
      "targets": [
        {"expr": "sum(rate(justnews_requests_total[1m]))", "legendFormat": "req/s"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0}
          ]}
        }
      }
    },
    {
      "id": 10,
      "title": "Latency p50 (ms)",
      "type": "stat",
      "gridPos": {"h": 3, "w": 6, "x": 6, "y": 6},
      "targets": [
        {"expr": "histogram_quantile(0.5, rate(justnews_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p50"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "orange", "value": 500},
            {"color": "red", "value": 1000}
          ]}
        }
      }
    },
    {
      "id": 11,
      "title": "Latency p95 (ms)",
      "type": "stat",
      "gridPos": {"h": 3, "w": 6, "x": 12, "y": 6},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(justnews_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p95"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "orange", "value": 1000},
            {"color": "red", "value": 2000}
          ]}
        }
      }
    },
    {
      "id": 12,
      "title": "Latency p99 (ms)",
      "type": "stat",
      "gridPos": {"h": 3, "w": 6, "x": 18, "y": 6},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(justnews_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p99"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "orange", "value": 2000},
            {"color": "red", "value": 5000}
          ]}
        }
      }
    },
    {
      "id": 13,
      "title": "Queue Depth",
      "type": "stat",
      "gridPos": {"h": 3, "w": 12, "x": 0, "y": 9},
      "targets": [
        {"expr": "sum(justnews_processing_queue_size)", "legendFormat": "items"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "orange", "value": 1000},
            {"color": "red", "value": 5000}
          ]}
        }
      }
    },
    {
      "id": 14,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": {"h": 3, "w": 12, "x": 12, "y": 9},
      "targets": [
        {"expr": "sum(justnews_active_connections)", "legendFormat": "conns"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0}
          ]}
        }
      }
    },
    {
      "id": 15,
      "title": "Quality & Publishing",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
      "collapsed": false
    },
    {
      "id": 16,
      "title": "Editorial Acceptance Rate (median)",
      "type": "stat",
      "gridPos": {"h": 3, "w": 6, "x": 0, "y": 13},
      "targets": [
        {"expr": "histogram_quantile(0.5, rate(justnews_stage_b_editorial_acceptance_bucket[5m]))", "legendFormat": "acceptance"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": 0},
            {"color": "orange", "value": 0.6},
            {"color": "green", "value": 0.8}
          ]}
        }
      }
    },
    {
      "id": 17,
      "title": "Publishing Latency p50 (ms)",
      "type": "stat",
      "gridPos": {"h": 3, "w": 6, "x": 6, "y": 13},
      "targets": [
        {"expr": "histogram_quantile(0.5, rate(justnews_stage_b_publishing_latency_seconds_bucket[5m])) * 1000", "legendFormat": "p50"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "orange", "value": 1000},
            {"color": "red", "value": 5000}
          ]}
        }
      }
    },
    {
      "id": 18,
      "title": "Publishing Latency p95 (ms)",
      "type": "stat",
      "gridPos": {"h": 3, "w": 6, "x": 12, "y": 13},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(justnews_stage_b_publishing_latency_seconds_bucket[5m])) * 1000", "legendFormat": "p95"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "orange", "value": 3000},
            {"color": "red", "value": 10000}
          ]}
        }
      }
    },
    {
      "id": 19,
      "title": "Total Requests (24h)",
      "type": "stat",
      "gridPos": {"h": 3, "w": 6, "x": 18, "y": 13},
      "targets": [
        {"expr": "sum(increase(justnews_requests_total[24h]))", "legendFormat": "total"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0}
          ]}
        }
      }
    },
    {
      "id": 20,
      "title": "Trends",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Request Rate Over Time",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 17},
      "targets": [
        {"expr": "sum(rate(justnews_requests_total[1m]))", "legendFormat": "req/s"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 22,
      "title": "System Resource Utilization",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 17},
      "targets": [
        {"expr": "avg(1 - (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "cpu"},
        {"expr": "avg((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)))", "legendFormat": "memory"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 23,
      "title": "Operations Impact",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24},
      "collapsed": false
    },
    {
      "id": 24,
      "title": "Queue Depth Trend",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 25},
      "targets": [
        {"expr": "sum(justnews_processing_queue_size)", "legendFormat": "items"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 25,
      "title": "Connection Count",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 25},
      "targets": [
        {"expr": "sum(justnews_active_connections)", "legendFormat": "connections"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 26,
      "title": "Latency Distribution (p99)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 25},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(justnews_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p99_ms"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    }
  ],
  "version": 1,
  "schemaVersion": 36,
  "style": "dark"
}
