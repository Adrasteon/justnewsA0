[Unit]
Description=JustNews vLLM Mistral-7B Service (example)
After=network.target

[Service]
Type=simple
# Expects vllm to be installed in the project UV/.venv.
ExecStart=$HOME/JustNews/scripts/run_with_env.sh bash -lc '"${PYTHON_BIN:-$HOME/JustNews/.venv/bin/python}" -m vllm --model "$VLLM_MODEL" --dtype bf16 --max-batch-size 4 --port 7060'
Restart=on-failure
RestartSec=10
MemoryMax=48G
CPUQuota=80%
LimitNOFILE=65536
Environment=PATH=$HOME/JustNews/.venv/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
