{
    "name": "Trixie CUDA Dev",
    "dockerComposeFile": "docker-compose.yaml",
    "service": "app",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "mtxr.sqltools",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    "forwardPorts": [3306, 3307, 8001, 8100],
    "initializeCommand": "bash .devcontainer/scripts/pre-build-cleanup.sh || bash /app/.devcontainer/scripts/pre-build-cleanup.sh || true",
    "postCreateCommand": "/usr/local/bin/create_deps_venv.sh",
    "remoteUser": "root",
    "remoteEnv": {
        "DOCKER_BUILDKIT": "1",
        "COMPOSE_DOCKER_CLI_BUILD": "1"
    }
}